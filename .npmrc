# Dependency install scripts are denied — the same posture the pnpm
# scaffold enforces per-package. Flip to false only with a comment naming
# what breaks without it.
#
# What npm cannot give you is pnpm's 48-hour quarantine on newly
# published dependency versions (minimumReleaseAge): under npm a routine
# install can pick up a day-zero compromised release the day it ships.
# That protection exists only under pnpm.
ignore-scripts=true
